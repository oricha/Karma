# Karma Platform — copy to .env and fill in values

# Backend (Spring Boot)
KARMA_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/karma_local
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_PROFILES_ACTIVE=local
KARMA_FRONTEND_ORIGIN=http://localhost:8080
KARMA_SECURITY_REQUIRE_HTTPS=false

# Email (production: sendgrid; local email is disabled unless you run MailHog)
KARMA_EMAIL_ENABLED=false
KARMA_EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
KARMA_EMAIL_FROM=noreply@karma.app
KARMA_EMAIL_RATE_LIMIT_PER_DAY=100

# Schedulers (enable gradually in production)
KARMA_SCHEDULER_DIGEST_ENABLED=false
KARMA_SCHEDULER_REMINDER_ENABLED=false
KARMA_SCHEDULER_REVIEW_REQUEST_ENABLED=false
KARMA_SCHEDULER_STORAGE_ORPHAN_CLEANUP_ENABLED=false

# S3 uploads (optional)
KARMA_STORAGE_ENABLED=false
KARMA_STORAGE_BUCKET=karma-platform-uploads
KARMA_STORAGE_REGION=eu-west-1
KARMA_STORAGE_ACCESS_KEY=
KARMA_STORAGE_SECRET_KEY=

# Frontend (Vite)
VITE_API_URL=

# Test/prod database URLs must point to Neon and include ?sslmode=require.
